<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
  <SpaRoot>ClientApp\</SpaRoot>
  </PropertyGroup>

  <Target Name="BuildAngularForPublish" AfterTargets="ComputeFilesToPublish">
    <Message Importance="high" Text="Building Angular app for Azure publish..." />

    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />

    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot" />

    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --configuration production --output-path ../wwwroot" />

    <ItemGroup>
      <AngularFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />

      <ResolvedFileToPublish Include="@(AngularFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
